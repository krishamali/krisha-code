/*sticky header*/
.sticky {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100%;
    background: #dddddd;
    z-index: 9999;
    padding: 6px 0;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
}

.site--header {
    position: relative;
    z-index: 1000;
    background: #fff;
}
.navbar ul {
    list-style: none;
    gap: 50px;
    font-size: 18px;
    font-weight: 500;
}
.navbar ul li {
    position: relative;
    padding-right: 22px;
}
.navbar {
    z-index: 1100;
}
/*sub-menu*/

.has-submenu::after {
    content: "";
    display: inline-block;
    margin-left: 6px;
    border: solid #222;
    border-width: 0 2px 2px 0;
    padding: 3px;
    transition: transform 0.3s ease;
    position: absolute;
    top: 5px;
    right: 0;
    transform: translateY(-50%) rotate(45deg);
}
.has-submenu.open::after {
    transform: translateY(-50%) rotate(-135deg);
}
.sub-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: #fff;
    padding: 15px 0;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px);
    transition: all 0.3s ease;
}

.sub-menu li a {
    display: block;
    padding: 12px 20px;
    color: #333;
    font-size: 17px;
    transition: background 0.3s ease;
}

.has-submenu:hover .sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}
/* sub-menu in to sub-menu*/
.sub-menu .has-submenu > .sub-menu {
    top: 0;
    left: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateX(15px);
    transition: all 0.3s ease;
}
.sub-menu .has-submenu:hover > .sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
}

.has-submenu > .sub-menu > ::after {
    right: 15px;
}
/*mobile-menu*/
.toggle-menu {
    flex-direction: column;
    cursor: pointer;
    margin-left: 10px;
}
.toggle-menu .bar {
    width: 24px;
    height: 3px;
    background-color: #000;
    margin-top: 4px;
    transition: 0.3s ease;
}
.toggle-btn {
    display: none;
}
.toggle-menu.active .bar:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
}

.toggle-menu.active .bar:nth-child(2) {
    opacity: 0;
}

.toggle-menu.active .bar:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
}
body.menu-open {
    overflow: hidden;
    position: relative;
}
body.menu-open::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    inset: 0;
    background: rgb(0 0 0 / 54%);
    z-index: 900;
}



.has-submenu {
    position: relative;
}

.has-submenu.open::after {
    transform: translateY(-50%) rotate(-135deg);
}
@media (max-width: 991px) {
    .navbar ul {
        gap: 30px;
    }
}
@media (max-width: 767px) {
    .hader--btn {
        display: none;
    }

    .toggle-btn {
        display: block;
    }

    .navbar {
        position: fixed;
        top: 128px;
        right: 0;
        width: 280px;
        height: calc(100vh - 128px);
        background: #e4e4e4;
        padding: 40px 20px;
        transform: translateX(100%);
        transition: 0.4s;
        overflow-y: auto;
    }

    .navbar.active {
        transform: translateX(0);
    }

    .navbar ul {
        flex-direction: column;
        gap: 40px;
    }

    .has-submenu .sub-menu {
        display: none;
        position: relative;
        left: 0;
        top: 0;
        opacity: 1;
        visibility: visible;
        transform: none;
        box-shadow: none;
        background: transparent;
        padding-left: 20px;
        margin-top: 10px;
        width: 100%;
    }

    .has-submenu.open > .sub-menu {
        display: block !important;
    }
    .has-submenu .sub-menu {
        display: none;
    }

    /* submenu inside submenu */
    .sub-menu .has-submenu > .sub-menu {
        position: relative;
        left: 0;
        top: 0;
        transform: none;
        opacity: 1;
        visibility: visible;
    }

    .sub-menu .has-submenu:hover > .sub-menu {
        transform: none;
    }
    .sub-menu {
        padding-left: 5px;
        margin-top: 5px;
    }

    .sub-menu .sub-menu {
        padding: 0px 0px 0px 10px;
    }

    .sub-menu li a {
        padding: 12px 0;
    }
}
document.addEventListener("DOMContentLoaded", function () {
    // Mobile menu toggle
    const menuBtn = document.getElementById("mobile-menu");
    const nav = document.querySelector(".navbar");

    menuBtn.onclick = () => {
        menuBtn.classList.toggle("active");
        nav.classList.toggle("active");
        document.body.classList.toggle("menu-open");
    };

    // Sticky header
    const header = document.querySelector(".site--header");

    window.addEventListener("scroll", () => {
        header.classList.toggle("sticky", window.scrollY > 100);
    });

    // Mobile submenu toggle

    const submenuItems = document.querySelectorAll(".has-submenu");

    submenuItems.forEach((item) => {
        item.addEventListener("click", function (e) {
            if (window.innerWidth <= 767) {
                const rect = item.getBoundingClientRect();

                if (e.clientX - rect.left > rect.width - 35) {
                    e.preventDefault();
                    e.stopPropagation();

                    // close same level menus
                    const siblings = item.parentElement.querySelectorAll(
                        ":scope > .has-submenu",
                    );

                    siblings.forEach((other) => {
                        if (other !== item) {
                            other.classList.remove("open");
                        }
                    });

                    // toggle current
                    item.classList.toggle("open");
                }
            }
        });
    });
});
